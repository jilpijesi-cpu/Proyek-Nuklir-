# Salin file ini menjadi keystore.properties (jangan di-commit), lalu isi.
#
# Buat keystore SEKALI, lalu simpan cadangannya di tempat aman. Kalau keystore atau sandinya hilang,
# versi baru tidak bisa dipasang menimpa versi lama (harus uninstall dulu dan data aplikasi hilang).
#
#   keytool -genkeypair -v -keystore release.jks -alias kita -keyalg RSA -keysize 2048 -validity 10000
#
# storeFile dihitung dari folder proyek ini.
storeFile=release.jks
storePassword=
keyAlias=kita
keyPassword=
