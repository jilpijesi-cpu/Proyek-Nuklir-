<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema aplikasi: aksen merek di seluruh kontrol bawaan (tombol dialog, kursor, switch, dll). -->
    <style name="Theme.Kita" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/kita_brand</item>
        <item name="android:colorAccent">@color/kita_brand</item>
        <item name="android:colorControlActivated">@color/kita_brand</item>
        <item name="android:textColorPrimary">@color/kita_text</item>
        <item name="android:windowBackground">@color/kita_bg</item>
        <item name="android:alertDialogTheme">@style/Theme.Kita.Dialog</item>
    </style>

    <!-- Layar pembuka: status/navigation bar disembunyikan supaya gambar penuh layar, tanpa transisi default. -->
    <style name="Theme.Kita.Splash" parent="android:Theme.Material.Light.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- Tombol dialog: tanpa huruf kapital semua, tebal, warna merek. -->
    <style name="Kita.DialogButton" parent="android:Widget.Material.Button.Borderless.Colored">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/kita_brand</item>
        <item name="android:minWidth">72dp</item>
    </style>

    <!-- Dialog: sudut membulat besar, aksen merek. -->
    <style name="Theme.Kita.Dialog" parent="android:Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">@color/kita_brand</item>
        <item name="android:colorPrimary">@color/kita_brand</item>
        <item name="android:colorControlActivated">@color/kita_brand</item>
        <item name="android:textColorPrimary">@color/kita_text</item>
        <item name="android:buttonBarButtonStyle">@style/Kita.DialogButton</item>
        <item name="android:windowBackground">@drawable/dialog_bg</item>
    </style>
</resources>
